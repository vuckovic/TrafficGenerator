# TrafficGenerator cluster configuration
# Copy to deploy/cluster.env and adjust. Sourced by install-prereqs.sh,
# the Ansible playbook and tests/cluster/connectivity_test.sh.

# ---------------------------------------------------------------------------
# Nodes. Index = node id 1..6 (CMNODE01 runs web UI/controller)
# ---------------------------------------------------------------------------
NODE_COUNT=6
# Existing node names (kept as-is; index 1..6 = node id)
NODE_HOSTNAMES=(CMNODE01 CMNODE02 CMNODE03 CMNODE04 CMNODE05 CMNODE06)
NODE_RAM_GB=(16 16 16 16 8 8)             # CMNODE01-04 16 GB, CMNODE05-06 8 GB
SSH_USER="pi"                             # login user on all nodes (tests, Ansible)
CONTROLLER_NODE=1                         # node hosting the web interface

# ---------------------------------------------------------------------------
# Management network (web UI, SSH, Ansible, chrony).
# All 6 nodes and both board RJ45 ports (ETH0, ETH1) sit on ONE internal
# switch = one L2 segment. Management and traffic are separated by subnet.
# MGMT_MODE=keep   -> existing names/IPs are kept untouched; installer only
#                     verifies them (default - nodes are already addressed)
# MGMT_MODE=static -> installer creates static NetworkManager profiles
# ---------------------------------------------------------------------------
MGMT_MODE="keep"
MGMT_IFACE="eth0"
MGMT_PREFIX="192.168.100"                 # node N has ${MGMT_PREFIX}.$((MGMT_HOST_BASE+N))
MGMT_HOST_BASE=10                         # -> CMNODE01 .11 ... CMNODE06 .16
MGMT_CIDR=24
MGMT_GW="192.168.100.1"                   # used only with MGMT_MODE=static
MGMT_DNS="192.168.100.1"                  # used only with MGMT_MODE=static
WEB_UI_PORT=8080

# ---------------------------------------------------------------------------
# Traffic network. Route server is connected to board port ETH0.
# TRAFFIC_MODE=untagged -> secondary IP on eth0 in a separate subnet (default,
#                          decided 2026-10-16: no VLAN tagging for now)
# TRAFFIC_MODE=vlan     -> 802.1Q sub-interface eth0.<VLAN> (kept for later)
# ---------------------------------------------------------------------------
TRAFFIC_MODE="untagged"
TRAFFIC_VLAN=100
TRAFFIC_PREFIX="10.100.0"                 # node N gets ${TRAFFIC_PREFIX}.$((TRAFFIC_HOST_BASE+N))
TRAFFIC_HOST_BASE=10
TRAFFIC_CIDR=24
# Route server on board port ETH0 (reachability test T11). Empty = skip.
ROUTE_SERVER_IP=""                        # e.g. 10.100.0.1
# Receiver for the 1 Gbit/s aggregate test T09. Empty = skip.
#  - external host on ETH0 (route server) running iperf3 -s on 5201-5206, or
#  - STAND-IN: a node's own traffic IP, e.g. 10.100.0.16 = CMNODE06; the test
#    then starts the receivers there itself and the other 5 nodes send to it.
SINK_IP=""                                # e.g. 10.100.0.1 or 10.100.0.16

# ---------------------------------------------------------------------------
# Host tuning
# ---------------------------------------------------------------------------
DISABLE_RADIOS="yes"                      # disable on-module Wi-Fi/BT if present
CPU_GOVERNOR="performance"
NTP_UPSTREAM="pool.ntp.org"               # used by controller node only

# P3: agent service on every node (management network) and its shared token
AGENT_PORT=7700
AGENT_TOKEN_FILE=/etc/tgen/agent.token
