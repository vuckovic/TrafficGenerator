# TrafficGenerator cluster configuration
# Copy to deploy/cluster.env and adjust. Sourced by install-prereqs.sh,
# the Ansible playbook and tests/cluster/connectivity_test.sh.

# ---------------------------------------------------------------------------
# Nodes. Index = Super6C slot (1 = slot with HDMI/USB, runs web UI/controller)
# ---------------------------------------------------------------------------
NODE_COUNT=6
HOSTNAME_PREFIX="tgen"                    # -> tgen1 ... tgen6
NODE_RAM_GB=(16 16 16 16 8 8)             # informational, used by scheduler later
CONTROLLER_NODE=1                         # node hosting the web interface

# ---------------------------------------------------------------------------
# Management network (web UI, SSH, Ansible, chrony). Leaves the board via ETH1.
# MGMT_MODE=static | dhcp   (dhcp keeps your current OS network config)
# ---------------------------------------------------------------------------
MGMT_MODE="static"
MGMT_IFACE="eth0"
MGMT_PREFIX="192.168.50"                  # node N gets ${MGMT_PREFIX}.$((MGMT_HOST_BASE+N))
MGMT_HOST_BASE=10                         # -> .11 ... .16
MGMT_CIDR=24
MGMT_GW="192.168.50.1"
MGMT_DNS="192.168.50.1"
WEB_UI_PORT=8080

# ---------------------------------------------------------------------------
# Traffic network. Leaves the board via ETH2 towards DUT / IXP lab fabric.
# TRAFFIC_MODE=vlan     -> 802.1Q sub-interface eth0.<VLAN> (recommended)
# TRAFFIC_MODE=untagged -> secondary IP on eth0 in a separate subnet (fallback)
# ---------------------------------------------------------------------------
TRAFFIC_MODE="vlan"
TRAFFIC_VLAN=100
TRAFFIC_PREFIX="10.100.0"                 # node N gets ${TRAFFIC_PREFIX}.$((TRAFFIC_HOST_BASE+N))
TRAFFIC_HOST_BASE=10
TRAFFIC_CIDR=24
# Optional external sink / DUT on the ETH2 side (used by aggregate tests).
# Leave empty if nothing is connected yet; those tests are then skipped.
SINK_IP=""                                # e.g. 10.100.0.1 running "iperf3 -s"

# ---------------------------------------------------------------------------
# Host tuning
# ---------------------------------------------------------------------------
DISABLE_RADIOS="yes"                      # disable on-module Wi-Fi/BT if present
CPU_GOVERNOR="performance"
NTP_UPSTREAM="pool.ntp.org"               # used by controller node only
