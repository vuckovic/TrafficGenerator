# TrafficGenerator agent as a service (P3, docs/07-agent-api.md). The controller on
# CMNODE01 drives it over the management network. /etc/tgen/agent.env sets
#   TGEN_AGENT_LISTEN=<this node's management address>:7700
#   TGEN_TRAFFIC_IFACE=eth0
# and /etc/tgen/agent.token (mode 0600, owner tgen) holds the shared token.
[Unit]
Description=TrafficGenerator agent (emulated BGP routers / data plane)
After=network-online.target tgen-tuning.service
Wants=network-online.target

[Service]
User=tgen
EnvironmentFile=/etc/tgen/agent.env
ExecStart=/opt/tgen/bin/tgen-agent serve --listen ${TGEN_AGENT_LISTEN} --token-file /etc/tgen/agent.token --iface ${TGEN_TRAFFIC_IFACE}
# NET_ADMIN: the routers' /32 addresses; NET_RAW / NET_BIND_SERVICE: data plane (P6)
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
# generator is the first to go under memory pressure (spec §10.2)
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
